<Window x:Class="CabSpan.BugReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CabSpan — Report a Bug or Rig Alignment Issue"
        Width="660"
        Height="560"
        MinWidth="580"
        MinHeight="510"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgDeepBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">

    <Grid Margin="18,16,18,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Style="{StaticResource DarkCardStyle}" Margin="0,0,0,12" Padding="14,10">
            <DockPanel>
                <!-- Right: Mode Switcher (Bug Report vs Feature Suggestion) -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button x:Name="BtnModeBug"
                            Content="🐞 Report Bug"
                            Style="{StaticResource PrimaryCyanButtonStyle}"
                            Padding="12,6" FontSize="11.5" Margin="0,0,6,0"
                            Click="OnSwitchToBugModeClick"/>
                    <Button x:Name="BtnModeSuggestion"
                            Content="💡 Suggest Feature"
                            Style="{StaticResource SecondarySlateButtonStyle}"
                            Padding="12,6" FontSize="11.5"
                            Click="OnSwitchToSuggestionModeClick"/>
                </StackPanel>

                <StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtDialogHeaderTitle" Text="🐞 REPORT A BUG" FontSize="17" FontWeight="ExtraBold" Foreground="{StaticResource GoldLightBrush}"/>
                        <Border Background="{StaticResource GoldPillBgBrush}" BorderBrush="{StaticResource GoldDimBrush}" BorderThickness="1" CornerRadius="2" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtClientHashBadge" Text="CLIENT #ID" FontSize="10" FontWeight="Bold" Foreground="{StaticResource GoldLightBrush}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="TxtDialogSubtitle"
                               Text="Automatically attaches your anonymous monitor geometry &amp; FOV settings so layout/math issues can be reproduced."
                               FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- FORM BODY -->
        <Border Grid.Row="1" Style="{StaticResource DarkCardStyle}" Margin="0,0,0,12" Padding="14,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 0: Category & Optional Contact -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="TxtCategoryLabel" Text="1. Which subsystem had an issue?" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,5"/>
                        <ComboBox x:Name="CmbCategory" Height="30" VerticalContentAlignment="Center" FontSize="12"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="2. Discord / GitHub Handle (Optional)" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,5"/>
                        <TextBox x:Name="TxtContactHandle" Height="30" MaxLength="40" VerticalContentAlignment="Center"
                                 Background="{StaticResource InputSurfaceBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderNormalBrush}" Padding="8,4"
                                 ToolTip="Optional: Leave your Discord or GitHub username if you'd like the developer to follow up with you."/>
                    </StackPanel>
                </Grid>

                <!-- Row 1: Description Header + Counter -->
                <DockPanel Grid.Row="1" Margin="0,0,0,5">
                    <TextBlock x:Name="TxtDescriptionLabel"
                               Text="3. What went wrong? (20–350 chars, plain text without external links)"
                               FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="TxtCharCounter" Text="0 / 350 chars (min 20)" DockPanel.Dock="Right" HorizontalAlignment="Right"
                               FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource GoldLightBrush}"/>
                </DockPanel>

                <!-- Row 2: Description Box -->
                <TextBox x:Name="TxtBugDescription" Grid.Row="2"
                         AcceptsReturn="True" TextWrapping="Wrap" MaxLength="350"
                         VerticalScrollBarVisibility="Auto"
                         Background="{StaticResource InputSurfaceBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderNormalBrush}"
                         Padding="9,7" FontSize="12.5"
                         TextChanged="OnDescriptionTextChanged"/>

                <!-- Row 3: Read-Only Hardware Snapshot Preview -->
                <StackPanel Grid.Row="3" Margin="0,12,0,0">
                    <TextBlock Text="Attached Anonymous Monitor Topology Snapshot (Zero Personal Data):"
                               FontSize="11" FontWeight="Bold" Foreground="{StaticResource GoldLightBrush}" Margin="0,0,0,4"/>
                    <Border Background="{StaticResource InputSurfaceBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="2" Padding="8,6" MaxHeight="95">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="TxtSnapshotPreview" FontFamily="Consolas" FontSize="10.5"
                                       Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- FOOTER ACTIONS & STATUS -->
        <StackPanel Grid.Row="2">
            <TextBlock x:Name="TxtStatusMessage"
                       Text="Select a category and describe what happened above."
                       FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource CyanAccentBrush}"
                       Margin="2,0,2,8" TextWrapping="Wrap"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.35*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="1.25*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="0.6*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BtnSubmitDiscord" Grid.Column="0"
                        Content="📤 Send Bug Report to Dev (Discord)"
                        Style="{StaticResource PrimaryCyanButtonStyle}"
                        Click="OnSubmitDiscordClick"/>

                <Button x:Name="BtnOpenGitHub" Grid.Column="2"
                        Content="🐙 Open on GitHub (Add Screenshots)"
                        Style="{StaticResource SecondarySlateButtonStyle}"
                        Click="OnOpenGitHubClick"/>

                <Button Grid.Column="4"
                        Content="Close"
                        Style="{StaticResource SecondarySlateButtonStyle}"
                        Click="OnCloseClick"/>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
