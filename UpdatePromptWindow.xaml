<Window x:Class="CabSpan.UpdatePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CabSpan — Update Ready"
        Width="560"
        Height="310"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        Background="{StaticResource BgDeepBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">

    <Border Margin="16" Style="{StaticResource DarkCardStyle}" BorderBrush="{StaticResource CyanAccentBrush}" BorderThickness="1.5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🚀 CABSPAN UPDATE READY" FontSize="15" FontWeight="ExtraBold" Foreground="{StaticResource GoldLightBrush}"/>
                    <Border Background="{StaticResource GoldPillBgBrush}" BorderBrush="{StaticResource GoldDimBrush}" BorderThickness="1" CornerRadius="2" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtVersionBadge" Text="v1.1.0" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource GoldLightBrush}"/>
                    </Border>
                </StackPanel>
                <Button Content="✕ Later" DockPanel.Dock="Right" HorizontalAlignment="Right"
                        Style="{StaticResource FooterPillButtonStyle}" Click="OnLaterClick"/>
            </DockPanel>

            <!-- Release Notes Box -->
            <Border Grid.Row="1" Style="{StaticResource SubCardSurfaceStyle}" Padding="12,9" Margin="0,0,0,12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="TxtReleaseTitle" Text="What's New in This Release:" FontWeight="Bold" FontSize="12.5"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                        <TextBlock x:Name="TxtReleaseNotes" Text="Bug fixes and multi-monitor improvements."
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Progress / Auto-Update Status Text -->
            <TextBlock x:Name="TxtProgressStatus" Grid.Row="2"
                       Text="Hands-free installer: automatically downloads &amp; updates CabSpan in-place with zero zip extraction."
                       FontSize="11.5" Foreground="{StaticResource CyanAccentBrush}" FontWeight="SemiBold" Margin="0,0,0,10"/>

            <!-- 3 Action Buttons: Update Now, Always Update, Silence for 1 Week -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="1.15*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="1.1*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BtnUpdateNow" Grid.Column="0"
                        Content="⚡ Update &amp; Continue"
                        Style="{StaticResource PrimaryCyanButtonStyle}"
                        Padding="10,8" FontSize="12"
                        Click="OnUpdateNowClick"/>

                <Button x:Name="BtnAlwaysUpdate" Grid.Column="2"
                        Content="🔄 Always Auto-Update"
                        Style="{StaticResource AmberActionButtonStyle}"
                        Padding="10,8" FontSize="12"
                        ToolTip="Turns on automatic updates for future releases and installs this update now."
                        Click="OnAlwaysUpdateClick"/>

                <Button x:Name="BtnSilenceWeek" Grid.Column="4"
                        Content="🔕 Silence for 1 Week"
                        Style="{StaticResource SecondarySlateButtonStyle}"
                        Padding="10,8" FontSize="12"
                        ToolTip="Silences update notifications for 7 days."
                        Click="OnSilenceWeekClick"/>
            </Grid>
        </Grid>
    </Border>
</Window>
